#!/bin/bash
# SPDX-FileCopyrightText: 2026 NASpeed contributors
# SPDX-License-Identifier: GPL-3.0-only
set -e

if [[ ${1:-} == remove || ${1:-} == purge ]]; then
    rm -f /var/api/naspeed.sock
fi
if [[ ${1:-} == purge && -d /usr/local/naspeed ]]; then
    cd -P /usr/local/naspeed
    if [[ $PWD != /usr/local/naspeed && ! $PWD =~ ^/Volume[0-9]+/@apps/naspeed$ ]]; then
        echo "NASpeed: unexpected application directory during purge" >&2
        exit 1
    fi
    rm -rf --one-file-system -- data logs run webui .webui.* LICENSE
fi
systemctl daemon-reload || true

exit 0
