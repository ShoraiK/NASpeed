#!/bin/bash
# SPDX-FileCopyrightText: 2026 NASpeed contributors
# SPDX-License-Identifier: GPL-3.0-only
set -e

systemctl daemon-reload

if [ "$1" = "purge" ]; then
    rm -f /var/api/naspeed.sock
    rm -rf /usr/local/naspeed/data /usr/local/naspeed/logs
    systemctl disable naspeed.service 2>/dev/null || true
    systemctl daemon-reload
fi

exit 0
